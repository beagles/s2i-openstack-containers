ARG BASE_IMAGE=localhost/openstack/openstack-base:latest
ARG APPLIANCE_IMAGE=localhost/openstack/octavia-amphora-appliance:latest
ARG CENTOS_SOURCE_IMAGE=quay.io/centos/centos:stream10

# Like EDPM's os_source, keep the target OS separate from builder tooling.
# In particular, do not copy the DIB/QEMU appliance or service-container users.
FROM ${CENTOS_SOURCE_IMAGE} AS os_source
USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
COPY octavia-amphora-image/source-image-packages.txt /tmp/packages.txt
RUN source /etc/os-release && test "${ID}" = centos && test "${VERSION_ID}" = 10 && \
    for pair in 'coreutils-single coreutils' 'libcurl-minimal libcurl'; do \
      read -r old new <<< "${pair}"; \
      if rpm -q "${old}" >/dev/null 2>&1; then \
        dnf -y swap "${old}" "${new}" || exit 1; \
      fi; \
    done && \
    pkgs=$(grep -vE '^#|^$' /tmp/packages.txt | tr '\n' ' ') && \
    dnf -y --setopt=install_weak_deps=False install ${pkgs} && \
    dnf clean all && rm /tmp/packages.txt && \
    passwd -l root
# kernel-install may fail to generate an initramfs on container overlayfs.
# Use the same explicit, non-hostonly dracut invocation as the appliance.
RUN for kernel in /usr/lib/modules/*/vmlinuz; do \
      test -f "${kernel}" || exit 1; \
      kver=$(basename "$(dirname "${kernel}")"); \
      cp "${kernel}" "/boot/vmlinuz-${kver}" && \
      DRACUT_NO_XATTR=1 dracut --force --no-hostonly --no-hostonly-cmdline \
        "/boot/initramfs-${kver}.img" "${kver}" || exit 1; \
    done

# First produce a partitioned qcow2 without mounts, loop devices or chroot.
# APPLIANCE_IMAGE is the existing Containerfile's --target appliance output.
FROM ${APPLIANCE_IMAGE} AS source
USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
COPY octavia-amphora-image/scripts/make-source-image /usr/local/bin/make-amphora-source-image
ARG AMPHORA_SOURCE_SIZE=4G
RUN --mount=from=os_source,src=/,dst=/os-source,ro \
    bash /usr/local/bin/make-amphora-source-image /os-source /build/centos-source.qcow2

# Optional independently exportable input image (not a bootable amphora).
FROM ${BASE_IMAGE} AS source-image
ENV SRC_DIR=/build DEST_DIR=/target CHECKSUM_FILE=centos-source.sha256
COPY copy_out.sh /copy_out.sh
COPY --from=source /build/centos-source.qcow2 /build/
WORKDIR /build
RUN chmod 0755 /copy_out.sh && sha256sum centos-source.qcow2 > "${CHECKSUM_FILE}"
ENTRYPOINT ["/copy_out.sh"]

# Transport the source qcow2 and the scoped CentOS element override on a
# separate read-only disk, not in the appliance RAM or its build-tool root.
FROM source AS inputs
COPY octavia-amphora-image/source-image-elements/ /source-input/elements/
RUN cp /build/centos-source.qcow2 /source-input/centos-source.qcow2 && \
    size=$(du -sk /source-input | cut -f1) && \
    truncate -s "$((size + 131072))K" /appliance/source-image.ext4 && \
    mkfs.ext4 -q -F -d /source-input /appliance/source-image.ext4

FROM ${APPLIANCE_IMAGE} AS build
COPY --from=inputs /appliance/source-image.ext4 /appliance/source-image.ext4
ARG IMAGE_NAME=amphora-x64-haproxy
ARG AMPHORA_MEMORY=4096
ARG AMPHORA_CPUS=2
ARG AMPHORA_WORK_DISK=32G
ARG AMPHORA_TIMEOUT=6h
ARG AMPHORA_IMAGE_SIZE=3
WORKDIR /build
RUN AMPHORA_BUILD_METHOD=source-image run-amphora-appliance

FROM ${BASE_IMAGE}
LABEL summary="Octavia amphora image from a CentOS source image" \
      io.k8s.description="CentOS Stream 10 source-image-based Octavia amphora qcow2"
ARG IMAGE_NAME=amphora-x64-haproxy
ENV SRC_DIR=/build DEST_DIR=/target CHECKSUM_FILE=${IMAGE_NAME}.sha256
COPY copy_out.sh /copy_out.sh
COPY --from=build /build/${IMAGE_NAME}.qcow2 /build/
WORKDIR /build
RUN chmod 0755 /copy_out.sh && sha256sum "${IMAGE_NAME}.qcow2" > "${CHECKSUM_FILE}"
ENTRYPOINT ["/copy_out.sh"]
